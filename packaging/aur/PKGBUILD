# Maintainer: Lakis01 <contact@brett.chess>
pkgname=brett
pkgver=0.3.0
pkgrel=1
pkgdesc="Chess Preparation and Database Suite"
arch=('x86_64')
url="https://github.com/Lakis01/Brett"
license=('MIT')
depends=('hicolor-icon-theme' 'fontconfig' 'wayland' 'libxkbcommon' 'libx11')
makedepends=('cargo')
optdepends=(
    'stockfish: Default local UCI analysis engine'
    'lc0: Leela Chess Zero UCI engine'
    'firefox: Default web browser for external lookups'
)
provides=('brett')
conflicts=('brett-bin')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "Brett-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "Brett-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-targets
}

check() {
    cd "Brett-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --release --all-targets
}

package() {
    cd "Brett-${pkgver}"
    install -Dm755 "target/release/brett" "${pkgdir}/usr/bin/brett"
    install -Dm644 assets/brett.desktop "${pkgdir}/usr/share/applications/brett.desktop"
    install -Dm644 assets/brett.png "${pkgdir}/usr/share/icons/hicolor/128x128/apps/brett.png"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
