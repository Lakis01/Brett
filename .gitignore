/target
*.log
.DS_Store
*.brettpos

# Local test data: never redistributed, may be copyrighted
fixtures/local/

# ICCF reference database is hosted at https://github.com/Lakis01/brett-correspondence_reference_base
databases/iccf/*.si4
databases/iccf/*.sg4
databases/iccf/*.sn4

# Optional player-photo pack derived from Scid's Player_photos.zip. It has no
# explicit redistribution licence and is not part of Brett's MIT source.
# See docs/PHOTOS.md. The libwebp helper is a build artifact of the converter.
assets/photos.bin
scripts/libwebp_helper.so
scripts/__pycache__/

# Brett stores personal settings and API secrets here. They are outside the
# repository by default; these rules catch copies made while developing.
references.json
display.json
preparation.json
engine.json
brett*.json
.config/brett/
config/brett/

# Environment files and credentials. Use BRETT_LICHESS_TOKEN instead of
# writing a token into a tracked file.
.env
.env.*
!.env.example
*.token
*.secret
lip_*
*.pem
*.key

# Editor and agent scratch files
.opencode/
.idea/
.vscode/
